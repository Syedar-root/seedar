NODE_ENV=production

# Backend database config
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=seedar
DB_PASSWORD=change_me_db_password
DB_DATABASE=seedar_prod

# Backend runtime
PORT=3000
AES_SECRET=change_me_to_a_long_random_secret

# LangGraph checkpoint(Postgres) Configuration
AI_CHECKPOINT_PG_URL=postgresql://postgres:change_me_pg_password@postgres:5432/postgres

# MySQL container init config (used by docker-compose mysql service)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=seedar_prod
MYSQL_USER=seedar
MYSQL_PASSWORD=change_me_db_password
