{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:report": "jest --coverage --coverageReporters=text-summary --coverageReporters=html --coverageReporters=lcov",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts",
    "migration:create": "pnpm run typeorm -- migration:create src/migrations/ManualMigration",
    "migration:generate": "pnpm run typeorm -- migration:generate src/migrations/AutoMigration",
    "migration:run": "pnpm run typeorm -- migration:run",
    "migration:revert": "pnpm run typeorm -- migration:revert",
    "migration:show": "pnpm run typeorm -- migration:show",
    "migration:run:prod": "node ../../node_modules/typeorm/cli.js -d dist/config/typeorm.datasource.js migration:run"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.38",
    "@langchain/deepseek": "^1.0.21",
    "@langchain/langgraph": "^1.2.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.4.1",
    "@langchain/tavily": "^1.2.0",
    "@metric-engine/core": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@seedar/types": "workspace:*",
    "@types/chalk": "^2.2.4",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "csv-parser": "^3.2.0",
    "deepagents": "^1.8.8",
    "knex": "^3.1.0",
    "langchain": "^1.2.39",
    "mysql2": "^3.11.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "module/ai/services/ai-session-message.service.ts",
      "module/ai/services/ai-session.service.ts",
      "module/ai/services/ai.service.ts",
      "module/ai/services/chat/chat-checkpoint.service.ts",
      "module/ai/services/chat/chat-context.service.ts",
      "module/ai/services/chat/chat-llm.service.ts",
      "module/ai/services/chat/chat-prompt.service.ts",
      "module/dashboard/services/dashboard.service.ts",
      "module/dataset/services/dataset.service.ts",
      "module/datasource/datasource.validation.ts",
      "module/datasource/service/datasource.service.ts",
      "module/datasource/transformers/utc-time.transformer.ts",
      "module/query/query.service.ts",
      "module/query/dsl-transformer/dsl-transformer.v2.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^chalk$": "<rootDir>/../test/chalk.mock.ts"
    }
  }
}
