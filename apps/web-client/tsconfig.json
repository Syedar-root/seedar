{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "#pkg/seedar/*": [
        "../../packages/*/src/index.ts",
        "../../packages/*/src/index.tsx"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
